# Copie para ".env" e preencha. O arquivo .env NÃO vai para o git.

# Banco (PostgreSQL do docker-compose)
DB_USUARIO=tenviti
DB_SENHA=troque-esta-senha

# Gere com: openssl rand -hex 32
JWT_SEGREDO=

# Primeiro acesso: cria o super admin se ainda não existir nenhum
SUPERADMIN_EMAIL=admin@tenviti.local
SUPERADMIN_SENHA=

# Origens liberadas para o painel web (separadas por vírgula)
CORS_ORIGENS=http://localhost:8080

# Pasta das imagens enviadas (fora do Docker). No docker-compose já é /app/midia.
# MIDIA_DIR=midia

# Dados de exemplo (lojas Thai Cookies e LD Lanches com cardápio fictício), criados na subida do
# servidor se ainda não existirem. Deixe em branco para não criar.
DADOS_EXEMPLO=true
THAI_DONO_EMAIL=
THAI_DONO_SENHA=
LD_DONO_EMAIL=
LD_DONO_SENHA=
